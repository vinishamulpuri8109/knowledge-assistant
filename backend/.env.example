# Copy to .env and fill in. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Optional overrides
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
# Max cosine distance (0 = identical, 2 = opposite) for a chunk to count as relevant evidence.
# Calibrated on the sample manual: relevant hits 0.21-0.32, off-topic 0.39+.
RETRIEVAL_MAX_DISTANCE=0.35
TOP_K=5
